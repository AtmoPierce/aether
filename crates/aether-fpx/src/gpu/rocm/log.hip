    if (xf < 0.0f) { return fpx_f32_to_half(nanf("")); }
    if (isinf(xf)) { return fpx_f32_to_half(INFINITY); }
    if (xf == 1.0f) { return fpx_f32_to_half(0.0f); }
    int e = 0;
