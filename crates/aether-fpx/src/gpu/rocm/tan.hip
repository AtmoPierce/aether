__device__ __forceinline__ fpx_half tan_seg2_f16(fpx_half x) {
    fpx_half z = fpx_mul_f16(x, x);
    fpx_half p = fpx_decode_f16_bits(tan_seg2_coeffs_f16_bits[14]);
    for (int i = 13; i >= 0; --i) { p = fpx_mul_add_f16(p, z, fpx_decode_f16_bits(tan_seg2_coeffs_f16_bits[i])); }
    return fpx_add_f16(x, fpx_mul_f16(fpx_mul_f16(x, z), p));
}

