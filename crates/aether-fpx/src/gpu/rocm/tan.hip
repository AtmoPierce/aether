__device__ __forceinline__ double tan_kernel_eval_double(double x) {
    double ax = fabs(x);
    if (ax <= 2.85398163397448279e-1) { return tan_seg0_double(x); }
    else if (ax <= 5.35398163397448279e-1) { return tan_seg1_double(x); }
    else if (ax <= 7.85398163397448279e-1) { return tan_seg2_double(x); }
    else { return tan_seg2_double(x); }
}

__device__ __forceinline__ float tan_kernel_eval_float(float x) {
    float ax = fabsf(x);
    if (ax <= 2.853981555e-1f) { return tan_seg0_float(x); }
    else if (ax <= 5.353981853e-1f) { return tan_seg1_float(x); }
    else if (ax <= 7.853981853e-1f) { return tan_seg2_float(x); }
    else { return tan_seg2_float(x); }
}

__device__ __forceinline__ fpx_half tan_kernel_eval_f16(fpx_half x) {
    fpx_half dispatch_x = fpx_abs_f16(x);
    if (fpx_le_f16(dispatch_x, fpx_f32_to_half(2.853981555e-1f))) { return tan_seg0_f16(x); }
    else if (fpx_le_f16(dispatch_x, fpx_f32_to_half(5.353981853e-1f))) { return tan_seg1_f16(x); }
    else if (fpx_le_f16(dispatch_x, fpx_f32_to_half(7.853981853e-1f))) { return tan_seg2_f16(x); }
    else { return tan_seg2_f16(x); }
}

