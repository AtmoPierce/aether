// Reduced-domain kernels accept inputs only in [0.00000000000000000e0, 7.85398163397448279e-1].
extern "C" double tan_reduced_domain_lo() { return 0.00000000000000000e0; }
extern "C" double tan_reduced_domain_hi() { return 7.85398163397448279e-1; }

extern "C" __global__ void tan_reduced_kernel_double(const double* xs, double* ys, size_t n) {
    size_t i = (size_t)(blockIdx.x * blockDim.x + threadIdx.x);
    if (i < n) { ys[i] = tan_kernel_eval_double(xs[i]); }
}

