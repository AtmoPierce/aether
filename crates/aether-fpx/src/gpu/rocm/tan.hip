    float dispatch_x = fabsf(fpx_fp4_e2m1_to_f32(x));
    if (dispatch_x <= 2.853981555e-1f) { return tan_seg0_fp4_e2m1(x); }
    else if (dispatch_x <= 5.353981853e-1f) { return tan_seg1_fp4_e2m1(x); }
