__device__ __forceinline__ double sin_kernel_eval_double(double x) {
    double ax = fabs(x);
    if (ax <= 2.56464751934642909e-1) { return sin_seg0_double(x); }
    else if (ax <= 5.06464751934642909e-1) { return sin_seg1_double(x); }
    else if (ax <= 8.53123493024678936e-1) { return sin_seg2_double(x); }
    else if (ax <= 1.10312349302467894e0) { return sin_seg3_double(x); }
    else if (ax <= 1.57079632679489656e0) { return sin_seg4_double(x); }
    else { return sin_seg4_double(x); }
}

