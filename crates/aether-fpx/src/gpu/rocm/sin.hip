// Reduced-domain kernels accept inputs only in [0.00000000000000000e0, 1.57079632679489656e0].
extern "C" double sin_reduced_domain_lo() { return 0.00000000000000000e0; }
extern "C" double sin_reduced_domain_hi() { return 1.57079632679489656e0; }

extern "C" __global__ void sin_reduced_kernel_double(const double* xs, double* ys, size_t n) {
    size_t i = (size_t)(blockIdx.x * blockDim.x + threadIdx.x);
    if (i < n) { ys[i] = sin_kernel_eval_double(xs[i]); }
}

