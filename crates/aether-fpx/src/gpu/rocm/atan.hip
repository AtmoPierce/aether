// Reduced-domain kernels accept inputs only in [0.00000000000000000e0, 1.00000000000000000e0].
extern "C" double atan_reduced_domain_lo() { return 0.00000000000000000e0; }
extern "C" double atan_reduced_domain_hi() { return 1.00000000000000000e0; }

extern "C" __global__ void atan_reduced_kernel_double(const double* xs, double* ys, size_t n) {
    size_t i = (size_t)(blockIdx.x * blockDim.x + threadIdx.x);
    if (i < n) { ys[i] = atan_kernel_eval_double(xs[i]); }
}

extern "C" __global__ void atan_reduced_kernel_float(const float* xs, float* ys, size_t n) {
