__device__ __forceinline__ double atan_kernel_eval_double(double x) {
    if (x <= 1.00000000000000006e-1) { return atan_seg0_double(x); }
    else if (x <= 2.00000000000000011e-1) { return atan_seg1_double(x); }
    else if (x <= 3.00000000000000044e-1) { return atan_seg2_double(x); }
    else if (x <= 5.30043004300430054e-1) { return atan_seg3_double(x); }
    else if (x <= 1.00000000000000000e0) { return atan_seg4_double(x); }
    else { return atan_seg4_double(x); }
}

__device__ __forceinline__ float atan_kernel_eval_float(float x) {
    if (x <= 1.000000015e-1f) { return atan_seg0_float(x); }
    else if (x <= 2.000000030e-1f) { return atan_seg1_float(x); }
    else if (x <= 3.000000119e-1f) { return atan_seg2_float(x); }
    else if (x <= 5.300430059e-1f) { return atan_seg3_float(x); }
    else if (x <= 1.000000000e0f) { return atan_seg4_float(x); }
    else { return atan_seg4_float(x); }
}

__device__ __forceinline__ fpx_half atan_kernel_eval_f16(fpx_half x) {
    fpx_half dispatch_x = x;
    if (fpx_le_f16(dispatch_x, fpx_f32_to_half(1.000000015e-1f))) { return atan_seg0_f16(x); }
    else if (fpx_le_f16(dispatch_x, fpx_f32_to_half(2.000000030e-1f))) { return atan_seg1_f16(x); }
    else if (fpx_le_f16(dispatch_x, fpx_f32_to_half(3.000000119e-1f))) { return atan_seg2_f16(x); }
    else if (fpx_le_f16(dispatch_x, fpx_f32_to_half(5.300430059e-1f))) { return atan_seg3_f16(x); }
    else if (fpx_le_f16(dispatch_x, fpx_f32_to_half(1.000000000e0f))) { return atan_seg4_f16(x); }
    else { return atan_seg4_f16(x); }
}

